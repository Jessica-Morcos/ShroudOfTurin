# Google Calendar used for the "Upcoming talks" section.
# The calendar must be public (Settings > Access permissions > Make available to public).
# Calendar ID is under Settings > Integrate calendar, e.g. abc123@group.calendar.google.com
VITE_GCAL_ID=
# API key from Google Cloud Console with the Google Calendar API enabled.
# Restrict it to your site's domain (HTTP referrers) since it ships to the browser.
VITE_GCAL_API_KEY=
