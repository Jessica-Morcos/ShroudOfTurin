# Google Calendar used for the "Upcoming talks" section. These are read server-side by
# api/events.js (and by the Vite dev server), so they never reach the browser.
# On Vercel, add them under Settings > Environment Variables.

# The calendar must be public with "See all event details" (Settings > Access permissions).
# Calendar ID is under Settings > Integrate calendar, e.g. abc123@group.calendar.google.com
GCAL_ID=
# API key from Google Cloud Console with the Google Calendar API enabled.
# Restrict it to the Google Calendar API; leave Application restrictions as "None",
# since requests come from the server rather than a browser.
GCAL_API_KEY=
